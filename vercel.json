{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run build:vercel && npm run check:vercel-runtime",
  "regions": [
    "fra1"
  ],
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/internal/rate-cleanup",
      "schedule": "17 3 * * *"
    }
  ]
}
