# Copy to .env.local; Next loads it. For Prisma/seed/test export env explicitly.
DATABASE_URL=postgresql://campus:CHANGE_ME@localhost:5432/campus_dev
BETTER_AUTH_URL=http://localhost:3000
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Explicit demo seed opt-in; use dedicated fictional demo data only.
ALLOW_DEMO_SEED=
DEMO_STAFF_PASSWORD=
DEMO_STUDENT_PASSWORD=
# Public deployments MUST set an ingress-overwritten single-IP header and block
# direct access to the app. Never enable this for arbitrary client headers.
# Unset is allowed only with a loopback BETTER_AUTH_URL for isolated local demo.
AUTH_TRUSTED_IP_HEADER=
# Optional direct Neon URL for controlled migrations; do not set in public runtime.
# Use sslmode=verify-full for Neon URLs. DATABASE_URL must be the pooled runtime URL.
DIRECT_DATABASE_URL=
# Random >=32 characters, only in runtime env; authenticates daily bounded cleanup.
CRON_SECRET=
