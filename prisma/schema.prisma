generator client {
 provider = "prisma-client"
 importFileExtension = "ts"
 output = "../src/generated/prisma"
}
datasource db {
 provider = "postgresql"
}
model User {
 id String @id
 name String
 email String @unique
 emailVerified Boolean @default(false)
 image String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 active Boolean @default(true)
 applicationTaken Application[] @relation("ApplicationTaken")
 applicationResolved Application[] @relation("ApplicationResolved")
 applicationEvents ApplicationEvent[]
 applicationDocuments ApplicationDocument[]
 authoredGrades Grade[]
 memberships UniversityMembership[]
 sessions Session[]
 accounts Account[]
}
model Session {
 id String @id
 token String @unique
 expiresAt DateTime
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 ipAddress String?
 userAgent String?
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@index([userId])
}
model Account {
 id String @id
 accountId String
 providerId String
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 accessToken String?
 refreshToken String?
 idToken String?
 accessTokenExpiresAt DateTime?
 refreshTokenExpiresAt DateTime?
 scope String?
 password String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([userId])
}
model Verification {
 id String @id
 identifier String
 value String
 expiresAt DateTime
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model University {
 id String @id
 name String
 timezone String
 active Boolean @default(true)
 semesters Semester[]
 teachers Teacher[]
 rooms Room[]
 subjects Subject[]
 faculties Faculty[]
 memberships UniversityMembership[]
}
model Faculty {
 active Boolean @default(true)
 version Int @default(1)
 id String @id
 name String
 universityId String
 university University @relation(fields:[universityId],references:[id])
 programs Program[]
}
model Program {
 active Boolean @default(true)
 version Int @default(1)
 id String @id
 name String
 facultyId String
 faculty Faculty @relation(fields:[facultyId],references:[id])
 templates ScheduleTemplate[]
 groups StudentGroup[]
}
model StudentGroup {
 version Int @default(1)
 submittedApplications Application[]
 lessonLinks ScheduleGroup[]
 templateLinks TemplateGroup[]
 lessons ScheduleEntry[]
 id String @id
 name String
 active Boolean @default(true)
 programId String
 program Program @relation(fields:[programId],references:[id])
 requests EnrollmentRequest[]
 enrollments GroupMembership[]
}
model UniversityMembership {
 id String @id @default(cuid())
 userId String
 universityId String
 role String @default("STUDENT")
 status String @default("PENDING")
 resubmissionAllowed Boolean @default(false)
 university University @relation(fields:[universityId],references:[id])
 user User @relation(fields:[userId],references:[id])
 applications Application[]
 profile StudentProfile?
 grades Grade[]
 requests EnrollmentRequest[]
 enrollments GroupMembership[]
 @@unique([id,universityId])
 @@unique([userId,universityId])
 @@index([universityId,role,status,id])
}
model StudentProfile {
 id String @id @default(cuid())
 membershipId String @unique
 firstName String
 lastName String
 membership UniversityMembership @relation(fields:[membershipId],references:[id])
}
model EnrollmentRequest {
 id String @id @default(cuid())
 membershipId String
 targetGroupId String
 status String @default("PENDING")
 reason String?
 decidedBy String?
 createdAt DateTime @default(now())
 decidedAt DateTime?
 membership UniversityMembership @relation(fields:[membershipId],references:[id])
 targetGroup StudentGroup @relation(fields:[targetGroupId],references:[id])
 @@index([membershipId,createdAt,id])
 @@index([status,createdAt,id])
}
model GroupMembership {
 id String @id @default(cuid())
 membershipId String
 groupId String
 startedAt DateTime @default(now())
 endedAt DateTime?
 revokedAt DateTime?
 sourceId String
 membership UniversityMembership @relation(fields:[membershipId],references:[id])
 group StudentGroup @relation(fields:[groupId],references:[id])
}
model AuditLog {
 id String @id @default(cuid())
 actorId String
 universityId String
 targetId String
 action String
 reason String?
 oldGroupId String?
 newGroupId String?
 createdAt DateTime @default(now())
}
model RateLimit {
 id String @id @default(cuid())
 key String @unique
 count Int
 lastRequest BigInt
 @@index([lastRequest, id])
}
model RateBucket {
 key String @id
 count Int @default(1)
 expiresAt DateTime
 @@index([expiresAt, key])
}

model ScheduleEntry {
 universityId String?
 semesterId String?
 semester Semester? @relation(fields:[semesterId,universityId],references:[id,universityId],onDelete:Restrict)
 templateId String?
 template ScheduleTemplate? @relation(fields:[templateId,universityId],references:[id,universityId],onDelete:Restrict)
 subjectId String?
 subject Subject? @relation(fields:[subjectId,universityId],references:[id,universityId],onDelete:Restrict)
 teacherId String?
 teacherRef Teacher? @relation(fields:[teacherId,universityId],references:[id,universityId],onDelete:Restrict)
 roomId String?
 roomRef Room? @relation(fields:[roomId,universityId],references:[id,universityId],onDelete:Restrict)
 slotDay String?
 generation Int @default(1)
 manual Boolean @default(false)
 sourceEntryId String?
 groups ScheduleGroup[]
 @@unique([templateId,slotDay,generation])
 @@index([universityId,startsAt])
 id String @id @default(cuid())
 groupId String
 group StudentGroup @relation(fields:[groupId],references:[id])
 title String
 teacher String?
 room String?
 startsAt DateTime @db.Timestamptz(3)
 endsAt DateTime @db.Timestamptz(3)
 status String @default("SCHEDULED")
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([groupId,startsAt])
}

model Subject {
 id String @id @default(cuid())
 universityId String
 university University @relation(fields:[universityId],references:[id],onDelete:Restrict)
 name String
 active Boolean @default(true)
 version Int @default(1)
 templates ScheduleTemplate[]
 lessons ScheduleEntry[]
 teachers TeacherSubject[]
 grades Grade[]
 @@unique([id,universityId])
 @@index([universityId,name,id])
}
model Grade {
 id String @id
 universityId String
 membershipId String
 membership UniversityMembership @relation(fields:[membershipId,universityId],references:[id,universityId],onDelete:Restrict)
 subjectId String
 subject Subject @relation(fields:[subjectId,universityId],references:[id,universityId],onDelete:Restrict)
 kind String
 mark Int?
 credit String?
 issuedOn DateTime @db.Date
 authorId String
 author User @relation(fields:[authorId],references:[id],onDelete:Restrict)
 voided Boolean @default(false)
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([membershipId,issuedOn,id])
 @@index([universityId,subjectId])
}

model Semester {
 id String @id
 universityId String
 university University @relation(fields:[universityId],references:[id],onDelete:Restrict)
 name String
 nameKey String
 start DateTime @db.Date
 end DateTime @db.Date
 anchor DateTime @db.Date
 exclusions Json
 version Int @default(1)
 templates ScheduleTemplate[]
 lessons ScheduleEntry[]
 @@unique([id,universityId])
 @@unique([universityId,nameKey])
}
model Teacher {
 id String @id
 universityId String
 university University @relation(fields:[universityId],references:[id],onDelete:Restrict)
 name String
 active Boolean @default(true)
 version Int @default(1)
 subjects TeacherSubject[]
 templates ScheduleTemplate[]
 lessons ScheduleEntry[]
 @@unique([id,universityId])
 @@index([universityId,name,id])
}
model Room {
 id String @id
 universityId String
 university University @relation(fields:[universityId],references:[id],onDelete:Restrict)
 building String
 number String
 nameKey String
 active Boolean @default(true)
 version Int @default(1)
 templates ScheduleTemplate[]
 lessons ScheduleEntry[]
 @@unique([id,universityId])
 @@unique([universityId,nameKey])
}
model TeacherSubject {
 teacherId String
 subjectId String
 universityId String
 active Boolean @default(true)
 teacher Teacher @relation(fields:[teacherId,universityId],references:[id,universityId],onDelete:Restrict)
 subject Subject @relation(fields:[subjectId,universityId],references:[id,universityId],onDelete:Restrict)
 @@id([teacherId,subjectId])
}
model ScheduleTemplate {
 segments Json @default("[]")
 id String @id
 universityId String
 semesterId String
 semester Semester @relation(fields:[semesterId,universityId],references:[id,universityId],onDelete:Restrict)
 programId String
 program Program @relation(fields:[programId],references:[id],onDelete:Restrict)
 subjectId String
 subject Subject @relation(fields:[subjectId,universityId],references:[id,universityId],onDelete:Restrict)
 teacherId String?
 teacher Teacher? @relation(fields:[teacherId,universityId],references:[id,universityId],onDelete:Restrict)
 roomId String?
 room Room? @relation(fields:[roomId,universityId],references:[id,universityId],onDelete:Restrict)
 recurrence String
 weekday Int
 once String
 startTime String
 endTime String
 version Int @default(1)
 groups TemplateGroup[]
 lessons ScheduleEntry[]
 @@unique([id,universityId])
 @@index([semesterId])
}
model TemplateGroup {
 templateId String
 groupId String
 template ScheduleTemplate @relation(fields:[templateId],references:[id],onDelete:Restrict)
 group StudentGroup @relation(fields:[groupId],references:[id],onDelete:Restrict)
 active Boolean @default(true)
 @@id([templateId,groupId])
}
model ScheduleGroup {
 entryId String
 groupId String
 entry ScheduleEntry @relation(fields:[entryId],references:[id],onDelete:Restrict)
 group StudentGroup @relation(fields:[groupId],references:[id],onDelete:Restrict)
 active Boolean @default(true)
 @@id([entryId,groupId])
 @@index([groupId,active])
}

model Application {
 id String @id
 universityId String
 membershipId String
 membership UniversityMembership @relation(fields:[membershipId,universityId],references:[id,universityId],onDelete:Restrict)
 submittedGroupId String
 submittedGroup StudentGroup @relation(fields:[submittedGroupId],references:[id],onDelete:Restrict)
 submittedGroupName String
 kind String
 status String @default("SUBMITTED")
 subject String
 description String?
 purpose String?
 responseText String?
 takenById String?
 takenBy User? @relation("ApplicationTaken",fields:[takenById],references:[id],onDelete:Restrict)
 takenAt DateTime? @db.Timestamptz(3)
 resolvedById String?
 resolvedBy User? @relation("ApplicationResolved",fields:[resolvedById],references:[id],onDelete:Restrict)
 resolvedAt DateTime? @db.Timestamptz(3)
 currentDocumentId String? @unique
 currentDocument ApplicationDocument? @relation("CurrentDocument",fields:[currentDocumentId,id,universityId],references:[id,applicationId,universityId],onDelete:Restrict)
 documents ApplicationDocument[] @relation("ApplicationDocuments")
 events ApplicationEvent[]
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@unique([id,universityId])
 @@unique([currentDocumentId,id,universityId])
 @@index([universityId,status,kind,createdAt,id])
 @@index([membershipId,createdAt,id])
}
model ApplicationDocument {
 id String @id
 applicationId String
 universityId String
 application Application @relation("ApplicationDocuments",fields:[applicationId,universityId],references:[id,universityId],onDelete:Restrict)
 currentFor Application? @relation("CurrentDocument")
 revision Int
 mediaType String
 byteSize Int
 sha256 String
 content Bytes
 uploadedById String
 uploadedBy User @relation(fields:[uploadedById],references:[id],onDelete:Restrict)
 replacesDocumentId String? @unique
 replaces ApplicationDocument? @relation("DocumentReplacement",fields:[replacesDocumentId,applicationId,universityId],references:[id,applicationId,universityId],onDelete:Restrict)
 replacedBy ApplicationDocument? @relation("DocumentReplacement")
 replacementReason String?
 demoConfirmed Boolean
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([id,applicationId,universityId])
 @@unique([applicationId,revision])
 @@unique([replacesDocumentId,applicationId,universityId])
 @@index([universityId,applicationId])
}
model ApplicationEvent {
 id String @id
 applicationId String
 universityId String
 application Application @relation(fields:[applicationId,universityId],references:[id,universityId],onDelete:Restrict)
 actorId String
 actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
 eventType String
 schemaVersion Int @default(1)
 fromStatus String?
 toStatus String?
 publicText String?
 documentId String?
 applicationVersion Int
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([applicationId,createdAt,id])
}
