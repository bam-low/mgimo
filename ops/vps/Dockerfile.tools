# Owner-only migration image; independently pinned vendor package inventory.
# The distroless cc base includes tracked glibc/OpenSSL/zlib/zstd and C++ runtime.
# No borrowed shared libraries, package metadata removal, shell or package manager.
FROM node:24.22.1-bookworm-slim@sha256:be8204d4bd327363357f532187b752ff62759c31bedf98e9e18fc08c9cbd605c AS node
FROM gcr.io/distroless/cc-debian13:nonroot@sha256:cc66d222f0a7ec996b78a99fe76a969bc80b539a5016ad866c14d1949bc6d0ab
LABEL io.campus.role="tools" io.campus.node="24.22.1"
COPY --from=node /usr/local/bin/node /usr/local/bin/node
WORKDIR /tools
COPY --chown=1000:1000 payload/ /tools/
ENV NODE_ENV=production PRISMA_SCHEMA_ENGINE_BINARY=/tools/node_modules/@prisma/engines/schema-engine-debian-openssl-3.0.x NEXT_TELEMETRY_DISABLED=1
USER 1000:1000
RUN ["node", "ops/vps/tools-check.mjs"]
ENTRYPOINT []
CMD ["node", "ops/vps/admin.mjs"]
